{
  "expo": {
    "name": "Karo",
    "slug": "karo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "karo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      },
      "bundleIdentifier": "com.anonymous.karo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow karo to record voice memos."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.anonymous.karo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    }
  }
}
